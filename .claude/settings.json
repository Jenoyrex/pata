{
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh repo edit:*)",
      "Read(./private/**)",
      "Read(./staging/test/**)",
      "Read(./staging/holdout/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "uv run --no-project python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pata_guard.py\" session-start", "timeout": 60 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "uv run --no-project python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pata_guard.py\" pre-bash", "timeout": 60 }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "uv run --no-project python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pata_guard.py\" pre-edit", "timeout": 30 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "uv run --no-project python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pata_guard.py\" post-edit", "timeout": 60 }
        ]
      }
    ]
  }
}
